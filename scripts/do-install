#
# installer script for wg_tool
# e.g. Call from PKGBUILD:  
#   ./do-install ${pkgdir}
#
set -euo pipefail

if (( $# < 1 )) ; then
    dest="./build/pkg"
else
    dest="$1"
fi
dest=$(realpath "$dest")

/usr/bin/rm -rf "$dest"

#
# Meson installer
#
/usr/bin/meson install -C build/release --destdir "$dest" > /dev/null

exit 0

